# File: len5.core
# Author: Michele Caon
#         Mattia Mirigaldi
# Date: 24/01/2024
# Description: LEN5 top-level core file

name: "polito:len5:len5:0.1.1"
description: "LEN5: out-of-order superscalar CPU"

filesets:
  rtl-bare:
    depend:
    - polito:len5:packages
    - polito:len5:common
    - polito:len5:frontend
    - polito:len5:expipe
    - polito:len5:datapath

  rtl-bare-tb:
    depend:
    - polito:len5:packages
    files:
    - tb/memory/tb_typedef.svh: {is_include_file: true, include_path: tb/memory}
    - tb/packages/tb_config_pkg.sv
    - rtl/vendor/pulp-axi/src/axi_pkg.sv
    - rtl/vendor/pulp-axi/src/axi_intf.sv
    - rtl/vendor/pulp-axi/include/axi/typedef.svh: {is_include_file: true, include_path: rtl/vendor/pulp-axi/include}
    - rtl/vendor/pulp-axi/include/axi/assign.svh: {is_include_file: true, include_path: rtl/vendor/pulp-axi/include}
    - rtl/vendor/pulp-axi/src/axi_sim_mem.sv: {is_include_file: true}
    - tb/memory/axi_sim/axi_memory_pkg.sv
    - tb/memory/tc_sram/memory_backend_pkg.sv
    - tb/memory/tc_sram/memory_access_check.sv
    - tb/memory/tc_sram/memory_response_buffer.sv
    - tb/memory/tc_sram/tc_sram_adapter.sv
    - tb/memory/axi_sim/axi_sim_adapter.sv
    - tb/memory/memory_class.svh: {is_include_file : true}
    - rtl/vendor/tech_cells_generic/tc_sram.sv
    - tb/memory/tc_sram_storage.sv
    - tb/memory/tc_sram_loader.svh: {is_include_file: true}
    - tb/memory/firmware_loader.svh: {is_include_file: true}
    - tb/memory/axi_sim/axi_sim_storage.sv
    - tb/memory/memory_protocol_monitor.sv
    - tb/memory/memory_if.sv
    - tb/memory/memory_bare_emu.sv
    - tb/len5_utils.svh: {is_include_file: true}
    - tb/tb_bare.sv
    - tb/memory/axi_sim/axi_sim_model.sv
    file_type: systemVerilogSource

  verilator-bare-tb:
    depend:
    - polito:len5:verilator-common
    files:
    - tb/verilator/len5_tb.cpp
    file_type: cppSource

  spike-checker:
    files:
    - tb/verilator/diff/checker.cpp
    - tb/verilator/diff/spike_adapter.cpp
    - tb/verilator/diff/monitor.cpp
    - tb/verilator/diff/annotate.cpp
    - tb/verilator/diff/checker.hh: {is_include_file: true}
    - tb/verilator/diff/monitor.hh: {is_include_file: true}
    - tb/verilator/diff/spike_adapter.hh: {is_include_file: true}
    - tb/verilator/diff/vector_bits.hh: {is_include_file: true}
    - tb/verilator/diff/signals.vlt: {file_type: vlt}
    file_type: cppSource

  questasim-bare-tb:
    files:
    - tb/len5_tb.sv
    file_type: systemVerilogSource

  verilator-waivers:
    files:
    - tb/memory/axi_sim/waivers.vlt
    - tb/memory/tc_sram/waivers.vlt
    - tb/misc/tb-waivers.vlt
    file_type: vlt

scripts:
  prepare_verilator:
    cmd:
    - bash
    - -c
    - 'rm -f Vtb_bare.mk'

  prepare_diff:
    cmd:
    - bash
    - -c
    - 'exec bash "$FILES_ROOT/scripts/sim/prepare-diff.sh"'

  # Create log directory
  prepare_dirs:
    cmd:
    - mkdir
    - -p
    - logs
  
  # Copy simulation logs and waveforms in common directory
  copy_logs:
    cmd:
    - bash
    - -c
    - 'exec bash "$FILES_ROOT/scripts/sim/copy-logs.sh" logs/waves.fst'

  # Post synthesis copy of reports
  syn-copy-results:
    cmd: 
    - cp 
    - -r 
    - reports 
    - ../../

targets:
  # Default target
  default: &default
    filesets:
    - rtl-bare
    - bare_tb ? (rtl-bare-tb)
    - tool_verilator ? (verilator-waivers)
    toplevel: len5_datapath

  # RTL simulation
  sim: &sim
    <<: *default
    default_tool: modelsim
    filesets_append:
    - rtl-bare-tb
    - tool_modelsim ? (questasim-bare-tb)
    - tool_verilator ? (verilator-bare-tb)
    toplevel: 
      - tool_verilator ? (tb_bare)
      - "!tool_verilator ? (len5_tb)"
    parameters:
    - BOOT_VM_MODE
    - BOOT_PC_HI
    - BOOT_PC_LO
    - LEN5_MULTIPLE_ISSUES
    - LEN5_M_EN
    - LEN5_DIV_EN
    - LEN5_F_EN
    - LEN5_D_EN
    - LEN5_C_EN
    - LEN5_A_EN
    - LEN5_STORE_LOAD_FWD_EN
    - MAX_EU_N
    - ONLY_DOUBLEWORD_MEM_ACCESSES
    - LEN5_CSR_HPMCOUNTERS_EN
    - MMAP_MASK_HI
    - MMAP_MASK_LO
    - BPU_HLEN
    - BPU_BTB_BITS
    - RAS_DEPTH
    - FETCH_MEMIF_FIFO_DEPTH
    - FETCH_MEM_DRAIN_ON_FLUSH
    - LOAD_BUFFER_DRAIN_ON_FLUSH
    - FETCH_REQ_SPILL_SKIP
    - FETCH_ANS_SPILL_SKIP
    - IQ_DEPTH
    - LDBUFF_DEPTH
    - STBUFF_DEPTH
    - LSU_SPILL_SKIP
    - ALU_RS_DEPTH
    - ALU_SPILL_SKIP
    - ALU_RR_ARBITER
    - MULT_RS_DEPTH
    - LEN5_MULT_SERIAL
    - MULT_PIPE_DEPTH
    - MULT_RR_ARBITER
    - DIV_RS_DEPTH
    - DIV_RR_ARBITER
    - FPU_RS_DEPTH
    - FPU_RR_ARBITER
    - FPU_PIPE_DEPTH
    - FPU_SPILL_SKIP
    - BU_RS_DEPTH
    - BU_SPILL_SKIP
    - ROB_DEPTH
    - COMMIT_SPILL_SKIP
    - BPU_INIT_C2B
    - MEMORY_BACKEND
    - AXI_CLOCK_HALF_PERIOD_PS
    - IMEM_BASE_ADDR_HI
    - IMEM_BASE_ADDR_LO
    - IMEM_SIZE_BYTES
    - IMEM_LATENCY
    - DMEM_BASE_ADDR_HI
    - DMEM_BASE_ADDR_LO
    - DMEM_SIZE_BYTES
    - DMEM_LATENCY
    - SERIAL_ADDR_HI
    - SERIAL_ADDR_LO
    - EXIT_ADDR_HI
    - EXIT_ADDR_LO
    - SRAM_SIM_INIT
    - firmware
    - firmware_base
    - memory_report
    - tool_verilator ? (max_cycles)
    - tool_verilator ? (log_level)
    - tool_verilator ? (dump_waves)
    - tool_verilator ? (dump_trace)
    hooks:
      pre_build:
      - tool_verilator ? (prepare_verilator)
      pre_run:
      - prepare_dirs
      post_run:
      - copy_logs
    tools:
      modelsim:
        vlog_options:
        - -override_timescale 1ns/1ps
        - -suppress vlog-2583
        - -suppress vlog-2577
        - -pedanticerrors
        - -define MODELSIM
        - -svinputport=compat
        - -hazards
        - -vmake
      verilator: &sim_verilator
        mode: cc
        verilator_options:
        - '--cc'
        - '--timing'
        - '--timescale 1ps/1ps'
        # Existing Verilator 5.040 DFG metadata bug: tb/frontend/RTL_VERIFICATION_FINDINGS.md T01.
        - '-fno-dfg'
        - '--assert'
        - '--trace'
        - '--trace-fst'
        - '--trace-structs'
        - '--trace-max-array 128'
        - '--x-assign unique'
        - '--x-initial unique'
        - '--report-unoptflat'
        - '-Wall'
        - '-Wpedantic'

  # FuseSoC owns compilation, linking and execution of the checked model.
  sim-diff:
    <<: *sim
    default_tool: verilator
    filesets_append:
    - rtl-bare-tb
    - verilator-bare-tb
    - spike-checker
    parameters_append:
    - run_dir
    - diff_output
    - diff_recovery
    - diff_progress
    - diff_fault
    hooks:
      pre_build:
      - prepare_diff
      pre_run:
      - prepare_dirs
    tools:
      verilator:
        <<: *sim_verilator
        verilator_options_append:
        - '--vpi'
        - '-Wno-DEPRECATED'
        - '-f diff-options.vc'
        make_options:
        - '-B'
        - 'OPT_FAST=-O2'
        - 'OPT_GLOBAL=-O2'
        run_options:
        - '--diff'

  # Format HDL with Verible
  format:
    filesets:
    - rtl-bare
    - rtl-bare-tb
    toplevel: len5_datapath
    description: Format source files using verible-verilog-format
    default_tool: veribleformat
    tools:
      veribleformat:
        verible_format_args:
        - '--assignment_statement_alignment=align'
        - '--case_items_alignment=align'
        - '--formal_parameters_indentation=indent'
        - '--named_parameter_alignment=align'
        - '--named_parameter_indentation=indent'
        - '--named_port_alignment=align'
        - '--named_port_indentation=indent'
        - '--port_declarations_alignment=align'
        - '--port_declarations_indentation=indent'
        - '--assignment_statement_alignment=align'
        - '--module_net_variable_alignment=align'
        - '--inplace'

  # Static analysis with Verible
  lint:
    filesets:
    - rtl-bare
    - rtl-bare-tb
    toplevel: len5_datapath
    description: Perform static analysis using Verible
    default_tool: veriblelint
    tools:
      veriblelint:
        ruleset: default
        verible_lint_args:
        - '--waiver_files=../../../rtl/misc/verible-lint.waiver'
        rules:
        - 'line-length=length:160'

# Parameters

parameters:
  run_dir:
    datatype: str
    description: Directory for this simulation's logs and waveforms.
    paramtype: cmdlinearg
  diff_output:
    datatype: str
    description: Directory for checker reports, relative to run_dir unless absolute.
    paramtype: cmdlinearg
  diff_recovery:
    datatype: int
    description: Maximum cycles waiting for frontend recovery.
    paramtype: cmdlinearg
  diff_progress:
    datatype: int
    description: Maximum cycles without an architectural commit.
    paramtype: cmdlinearg
  diff_fault:
    datatype: str
    description: Inject an observation fault for checker validation.
    paramtype: cmdlinearg
  log_level:
    datatype: str
    description: |
      Set the log level. Admitted values: LOG_NONE|LOG_LOW|LOG_MEDIUM|LOG_HIGH|LOG_FULL|LOG_DEBUG.
      Errors and configuration messages are always printed.
    paramtype: cmdlinearg
  dump_waves:
    datatype: str
    description: If 'true', dump waveforms
    default: "true"
    paramtype: cmdlinearg
  dump_trace:
    datatype: str
    description: If 'true', generate instruction execution trace
    default: "false"
    paramtype: cmdlinearg
  firmware_base:
    datatype: str
    description: Hexadecimal byte address for raw binary firmware (default zero, legacy convention).
    paramtype: plusarg
  memory_report:
    datatype: str
    description: Output path for memory performance JSON (default memory-performance.json).
    paramtype: plusarg
  firmware:
    datatype: str
    description: Firmware (in HEX format) to load into the system SRAM.
    paramtype: plusarg
  max_cycles:
    datatype: int
    description: Maximum number of simulation cycles (halt the simulation when reached).
    paramtype: cmdlinearg
  BOOT_VM_MODE:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BOOT_VM_MODE.
  LEN5_MULTIPLE_ISSUES:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_MULTIPLE_ISSUES.
  LEN5_M_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_M_EN.
  LEN5_DIV_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_DIV_EN.
  LEN5_F_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_F_EN.
  LEN5_D_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_D_EN.
  LEN5_C_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_C_EN.
  LEN5_A_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_A_EN.
  LEN5_STORE_LOAD_FWD_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_STORE_LOAD_FWD_EN.
  MAX_EU_N:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for MAX_EU_N.
  ONLY_DOUBLEWORD_MEM_ACCESSES:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for ONLY_DOUBLEWORD_MEM_ACCESSES.
  LEN5_CSR_HPMCOUNTERS_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_CSR_HPMCOUNTERS_EN.
  BPU_HLEN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BPU_HLEN.
  BPU_BTB_BITS:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BPU_BTB_BITS.
  RAS_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for RAS_DEPTH.
  FETCH_MEMIF_FIFO_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for FETCH_MEMIF_FIFO_DEPTH.
  FETCH_MEM_DRAIN_ON_FLUSH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for FETCH_MEM_DRAIN_ON_FLUSH.
  LOAD_BUFFER_DRAIN_ON_FLUSH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LOAD_BUFFER_DRAIN_ON_FLUSH.
  FETCH_REQ_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for FETCH_REQ_SPILL_SKIP.
  FETCH_ANS_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for FETCH_ANS_SPILL_SKIP.
  IQ_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for IQ_DEPTH.
  LDBUFF_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LDBUFF_DEPTH.
  STBUFF_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for STBUFF_DEPTH.
  LSU_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LSU_SPILL_SKIP.
  ALU_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for ALU_RS_DEPTH.
  ALU_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for ALU_SPILL_SKIP.
  ALU_RR_ARBITER:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for ALU_RR_ARBITER.
  MULT_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for MULT_RS_DEPTH.
  LEN5_MULT_SERIAL:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_MULT_SERIAL.
  MULT_PIPE_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for MULT_PIPE_DEPTH.
  MULT_RR_ARBITER:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for MULT_RR_ARBITER.
  DIV_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for DIV_RS_DEPTH.
  DIV_RR_ARBITER:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for DIV_RR_ARBITER.
  FPU_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for FPU_RS_DEPTH.
  FPU_RR_ARBITER:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for FPU_RR_ARBITER.
  FPU_PIPE_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for FPU_PIPE_DEPTH.
  FPU_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for FPU_SPILL_SKIP.
  BU_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BU_RS_DEPTH.
  BU_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BU_SPILL_SKIP.
  ROB_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for ROB_DEPTH.
  COMMIT_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for COMMIT_SPILL_SKIP.
  BPU_INIT_C2B:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BPU_INIT_C2B.
  MEMORY_BACKEND:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for MEMORY_BACKEND.
  AXI_CLOCK_HALF_PERIOD_PS:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for AXI_CLOCK_HALF_PERIOD_PS.
  IMEM_SIZE_BYTES:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for IMEM_SIZE_BYTES.
  IMEM_LATENCY:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for IMEM_LATENCY.
  DMEM_SIZE_BYTES:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for DMEM_SIZE_BYTES.
  DMEM_LATENCY:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for DMEM_LATENCY.
  SRAM_SIM_INIT:
    datatype: str
    paramtype: vlogparam
    description: Native SRAM simulation initialization.
  BOOT_PC_HI:
