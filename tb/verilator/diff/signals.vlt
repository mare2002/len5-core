public_flat_rd -module "csrs" -var "*"
public_flat_rd -module "arith_rs*" -var "*"
public_flat_rd -module "branch_rs" -var "*"
public_flat_rd -module "load_buffer" -var "*"
public_flat_rd -module "store_buffer" -var "*"
public_flat_rd -module "branch_unit" -var "*"
