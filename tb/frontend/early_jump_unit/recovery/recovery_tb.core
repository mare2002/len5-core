CAPI=2:
name: polito:len5:recovery-audit:0.1.0
filesets:
  test:
    depend:
      - polito:len5:len5
      - polito:len5:verilator-common
    files:
      - recovery_tb.sv
    file_type: systemVerilogSource
  driver:
    files: [recovery_tb.cpp]
    file_type: cppSource
targets:
  sim:
    flags:
      bare_tb: true
    default_tool: verilator
    filesets: [test, driver]
    toplevel: recovery_tb
    parameters:
    - BOOT_VM_MODE
    - BOOT_PC_HI
    - BOOT_PC_LO
    - LEN5_MULTIPLE_ISSUES
    - LEN5_M_EN
    - LEN5_DIV_EN
    - LEN5_F_EN
    - LEN5_D_EN
    - LEN5_C_EN
    - LEN5_A_EN
    - LEN5_STORE_LOAD_FWD_EN
    - MAX_EU_N
    - ONLY_DOUBLEWORD_MEM_ACCESSES
    - LEN5_CSR_HPMCOUNTERS_EN
    - MMAP_MASK_HI
    - MMAP_MASK_LO
    - BPU_HLEN
    - BPU_BTB_BITS
    - RAS_DEPTH
    - FETCH_MEMIF_FIFO_DEPTH
    - FETCH_MEM_DRAIN_ON_FLUSH
    - LOAD_BUFFER_DRAIN_ON_FLUSH
    - FETCH_REQ_SPILL_SKIP
    - FETCH_ANS_SPILL_SKIP
    - IQ_DEPTH
    - LDBUFF_DEPTH
    - STBUFF_DEPTH
    - LSU_SPILL_SKIP
    - ALU_RS_DEPTH
    - ALU_SPILL_SKIP
    - ALU_RR_ARBITER
    - MULT_RS_DEPTH
    - LEN5_MULT_SERIAL
    - MULT_PIPE_DEPTH
    - MULT_RR_ARBITER
    - DIV_RS_DEPTH
    - DIV_RR_ARBITER
    - FPU_RS_DEPTH
    - FPU_RR_ARBITER
    - FPU_PIPE_DEPTH
    - FPU_SPILL_SKIP
    - BU_RS_DEPTH
    - BU_SPILL_SKIP
    - ROB_DEPTH
    - COMMIT_SPILL_SKIP
    - MEMORY_BACKEND
    - AXI_CLOCK_HALF_PERIOD_PS
    - IMEM_BASE_ADDR_HI
    - IMEM_BASE_ADDR_LO
    - IMEM_SIZE_BYTES
    - IMEM_LATENCY
    - DMEM_BASE_ADDR_HI
    - DMEM_BASE_ADDR_LO
    - DMEM_SIZE_BYTES
    - DMEM_LATENCY
    - SRAM_SIM_INIT
    - SERIAL_ADDR_HI
    - SERIAL_ADDR_LO
    - EXIT_ADDR_HI
    - EXIT_ADDR_LO
    - BPU_INIT_C2B

    tools:
      verilator:
        make_options: [OBJCACHE=, CXX=/usr/bin/g++, -j4, OPT_FAST=-O2, OPT_GLOBAL=-O2]
        mode: cc
        verilator_options: [--assert, --trace-fst, --trace-structs, --trace-max-array, '128', -Wno-fatal]

parameters:
  BOOT_VM_MODE:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BOOT_VM_MODE.
  BOOT_PC_HI:
    datatype: int
    paramtype: vlogparam
  BOOT_PC_LO:
    datatype: int
    paramtype: vlogparam
  LEN5_MULTIPLE_ISSUES:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_MULTIPLE_ISSUES.
  LEN5_M_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_M_EN.
  LEN5_DIV_EN:
    datatype: int
