    paramtype: vlogparam
    description: Elaboration override for ALU_RR_ARBITER.
  MULT_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for MULT_RS_DEPTH.
  LEN5_MULT_SERIAL:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_MULT_SERIAL.
  MULT_PIPE_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for MULT_PIPE_DEPTH.
  MULT_RR_ARBITER:
