CAPI=2:
name: polito:len5:fetch-stage-tb:0.1.0
description: Closed-loop production fetch_stage verification, composed independent
  models
filesets:
  dut:
    depend:
    - polito:len5:common
    - polito:len5:frontend
    files:
    - fetch_stage_tb.sv
    file_type: systemVerilogSource
  harness:
    depend:
    - polito:len5:verilator-common
    files:
    - fetch_stage_components.hh:
        is_include_file: true
    - fetch_stage_components.cpp
    - fetch_stage_program.cpp
    - fetch_stage_composition.hh:
        is_include_file: true
    - fetch_stage_composition.cpp
    - fetch_stage_driver.hh:
        is_include_file: true
    - fetch_stage_ras_witness.hh:
        is_include_file: true
    - fetch_stage_driver.cpp
    - fetch_stage_configuration.cpp
    - fetch_stage_tb.cpp
    - ../pc_gen/pc_gen_model.hh:
        is_include_file: true
    - ../pc_gen/pc_gen_model.cpp
    - ../early_jump_unit/early_jump_model.hh:
        is_include_file: true
    - ../early_jump_unit/early_jump_model.cpp
    - ../early_jump_unit/early_jump_instructions.hh:
        is_include_file: true
    - ../early_jump_unit/early_jump_instructions.cpp
    - ../fetch_mem_if/fetch_mem_model.hh:
        is_include_file: true
    - ../fetch_mem_if/fetch_mem_model.cpp
    file_type: cppSource
  waivers:
    files:
    - fetch_stage_waivers.vlt
    file_type: vlt
targets:
  sim:
    flags:
      standalone_frontend: true
      fetch_stage_tb: true
    default_tool: verilator
    toplevel: fetch_stage_tb
    filesets:
    - dut
    - harness
    - waivers
    parameters:
    - BOOT_VM_MODE
    - LEN5_MULTIPLE_ISSUES
    - LEN5_M_EN
    - LEN5_DIV_EN
    - LEN5_F_EN
    - LEN5_D_EN
    - LEN5_C_EN
    - LEN5_A_EN
    - LEN5_STORE_LOAD_FWD_EN
    - MAX_EU_N
    - ONLY_DOUBLEWORD_MEM_ACCESSES
    - LEN5_CSR_HPMCOUNTERS_EN
    - MMAP_MASK_HI
    - MMAP_MASK_LO
    - BPU_HLEN
    - BPU_BTB_BITS
    - RAS_DEPTH
    - FETCH_MEMIF_FIFO_DEPTH
    - FETCH_MEM_DRAIN_ON_FLUSH
    - LOAD_BUFFER_DRAIN_ON_FLUSH
    - FETCH_REQ_SPILL_SKIP
    - FETCH_ANS_SPILL_SKIP
    - IQ_DEPTH
    - LDBUFF_DEPTH
    - STBUFF_DEPTH
    - LSU_SPILL_SKIP
    - ALU_RS_DEPTH
    - ALU_SPILL_SKIP
    - ALU_RR_ARBITER
    - MULT_RS_DEPTH
    - LEN5_MULT_SERIAL
    - MULT_PIPE_DEPTH
    - MULT_RR_ARBITER
    - DIV_RS_DEPTH
    - DIV_RR_ARBITER
    - FPU_RS_DEPTH
    - FPU_RR_ARBITER
    - FPU_PIPE_DEPTH
    - FPU_SPILL_SKIP
    - BU_RS_DEPTH
    - BU_SPILL_SKIP
    - ROB_DEPTH
    - COMMIT_SPILL_SKIP
    - BPU_INIT_C2B
    - MEM_DEPTH
    - BOOT_PC_HI
    - BOOT_PC_LO
    tools:
      verilator:
        mode: cc
        verilator_options:
        - --assert
        - -fno-dfg
        - --trace-fst
        - --trace-depth 1
        - --x-assign unique
        - --x-initial unique
        - -Wall
        - -Wpedantic
        make_options:
        - OBJCACHE=
        - CXX=/usr/bin/g++
        - -j4
        - OPT_FAST=-O2
        - OPT_GLOBAL=-O2
        - CXXFLAGS+=-std=c++17

parameters:
  MEM_DEPTH:
    datatype: int
    paramtype: vlogparam
    default: 2
    description: Source-derived production metadata-depth default; verified at startup
  BOOT_VM_MODE:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BOOT_VM_MODE.
  LEN5_MULTIPLE_ISSUES:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_MULTIPLE_ISSUES.
  LEN5_M_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_M_EN.
  LEN5_DIV_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_DIV_EN.
  LEN5_F_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_F_EN.
  LEN5_D_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_D_EN.
  LEN5_C_EN:
    datatype: int
