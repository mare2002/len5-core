    paramtype: vlogparam
    description: Elaboration override for MAX_EU_N.
  ONLY_DOUBLEWORD_MEM_ACCESSES:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for ONLY_DOUBLEWORD_MEM_ACCESSES.
  LEN5_CSR_HPMCOUNTERS_EN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for LEN5_CSR_HPMCOUNTERS_EN.
  BPU_HLEN:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BPU_HLEN.
  BPU_BTB_BITS:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for BPU_BTB_BITS.
  RAS_DEPTH:
    datatype: int
    paramtype: vlogparam
    description: Elaboration override for RAS_DEPTH.
