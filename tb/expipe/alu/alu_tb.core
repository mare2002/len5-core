    paramtype: vlogparam
  FETCH_REQ_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
  FETCH_ANS_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
  IQ_DEPTH:
    datatype: int
    paramtype: vlogparam
  LDBUFF_DEPTH:
    datatype: int
    paramtype: vlogparam
  STBUFF_DEPTH:
    datatype: int
    paramtype: vlogparam
  LSU_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
  ALU_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
  ALU_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
  ALU_RR_ARBITER:
    datatype: int
    paramtype: vlogparam
  MULT_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
  LEN5_MULT_SERIAL:
    datatype: int
    paramtype: vlogparam
  MULT_PIPE_DEPTH:
    datatype: int
    paramtype: vlogparam
  MULT_RR_ARBITER:
    datatype: int
    paramtype: vlogparam
  DIV_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
  DIV_RR_ARBITER:
    datatype: int
    paramtype: vlogparam
  FPU_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
  FPU_RR_ARBITER:
    datatype: int
    paramtype: vlogparam
  FPU_PIPE_DEPTH:
    datatype: int
    paramtype: vlogparam
  FPU_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
  BU_RS_DEPTH:
    datatype: int
    paramtype: vlogparam
  BU_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
  ROB_DEPTH:
    datatype: int
    paramtype: vlogparam
  COMMIT_SPILL_SKIP:
    datatype: int
    paramtype: vlogparam
  BPU_INIT_C2B:
    datatype: int
