CAPI=2:
# Copyright 2024 POLITO
# Solderpad Hardware License, Version 2.1, see LICENSE.md for details.
# SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
#
# File: len5_tb.core
# Author: Mattia Mirigaldi
# Date: 14/02/2024
# Description: LEN5 top-level core file

name: "polito:len5:alu-tb:0.1.0"
description: "LEN5 tb files and targets"

filesets:
  rtl-alu:
    depend:
    - polito:len5:packages
    - polito:len5:common
    - polito:len5:expipe
    files:
    - alu_tb.sv
    file_type: systemVerilogSource

  verilator-tb:
    depend:
    - polito:len5:verilator-common
    files:
    - tb_components.cpp
    - tb_components.hh: {is_include_file: true}
    - alu_tb.cpp
    file_type: cppSource

scripts:
  # Create log directory
  prepare_dirs:
    cmd:
    - mkdir
    - -p
    - logs
    - ../../sim-common

  # Copy waveform dump
  copy_waves:
    cmd:
    - bash
    - ../../../scripts/sim/copy-logs.sh
    - logs/waves.fst
  
targets:
  # Default target
  default: &default
    filesets:
    - rtl-alu
    - verilator-tb
    toplevel: alu_tb

  # RTL simulation
  sim:
    <<: *default
    default_tool: verilator
    hooks:
      pre_run:
      - prepare_dirs
      post_run:
      - copy_waves
    parameters:
    - BOOT_VM_MODE
    - BOOT_PC_HI
    - BOOT_PC_LO
    - LEN5_MULTIPLE_ISSUES
    - LEN5_M_EN
    - LEN5_DIV_EN
    - LEN5_F_EN
    - LEN5_D_EN
    - LEN5_C_EN
    - LEN5_A_EN
    - LEN5_STORE_LOAD_FWD_EN
    - MAX_EU_N
    - ONLY_DOUBLEWORD_MEM_ACCESSES
    - LEN5_CSR_HPMCOUNTERS_EN
    - MMAP_MASK_HI
    - MMAP_MASK_LO
    - BPU_HLEN
    - BPU_BTB_BITS
    - RAS_DEPTH
    - FETCH_MEMIF_FIFO_DEPTH
    - FETCH_MEM_DRAIN_ON_FLUSH
    - LOAD_BUFFER_DRAIN_ON_FLUSH
    - FETCH_REQ_SPILL_SKIP
    - FETCH_ANS_SPILL_SKIP
    - IQ_DEPTH
    - LDBUFF_DEPTH
    - STBUFF_DEPTH
    - LSU_SPILL_SKIP
    - ALU_RS_DEPTH
    - ALU_SPILL_SKIP
    - ALU_RR_ARBITER
    - MULT_RS_DEPTH
    - LEN5_MULT_SERIAL
    - MULT_PIPE_DEPTH
    - MULT_RR_ARBITER
    - DIV_RS_DEPTH
    - DIV_RR_ARBITER
    - FPU_RS_DEPTH
    - FPU_RR_ARBITER
    - FPU_PIPE_DEPTH
    - FPU_SPILL_SKIP
    - BU_RS_DEPTH
    - BU_SPILL_SKIP
    - ROB_DEPTH
    - COMMIT_SPILL_SKIP
    - BPU_INIT_C2B
    - tool_verilator ? (max_cycles)
    - tool_verilator ? (dump_waves)
    - tool_verilator ? (log_level)
    tools:
      verilator:
        mode: cc
        exe: true
        verilator_options:
        - '--cc'
        - '--assert'
        - '--trace'
        - '--trace-fst'
        - '--trace-structs'
        - '--trace-max-array 128'
        - '--x-assign unique'
        - '--x-initial unique'
        - '--report-unoptflat'
        - '-Wall'
        - '-Wpedantic'

# Parameters
parameters:
  log_level:
    datatype: str
    description: |
      Set the log level. Admitted values: LOG_NONE|LOG_LOW|LOG_MEDIUM|LOG_HIGH|LOG_FULL|LOG_DEBUG.
      Errors and configuration messages are always printed.
    paramtype: cmdlinearg
  dump_waves:
    datatype: str
    description: If 'true', dump waveforms
    default: "true"
    paramtype: cmdlinearg
  max_cycles:
    datatype: int
    description: Maximum number of simulation cycles (halt the simulation when reached).
    paramtype: cmdlinearg
  BOOT_VM_MODE:
    datatype: int
    paramtype: vlogparam
  LEN5_MULTIPLE_ISSUES:
    datatype: int
    paramtype: vlogparam
  LEN5_M_EN:
    datatype: int
    paramtype: vlogparam
  LEN5_DIV_EN:
    datatype: int
    paramtype: vlogparam
  LEN5_F_EN:
    datatype: int
    paramtype: vlogparam
  LEN5_D_EN:
    datatype: int
    paramtype: vlogparam
  LEN5_C_EN:
    datatype: int
    paramtype: vlogparam
  LEN5_A_EN:
    datatype: int
    paramtype: vlogparam
  LEN5_STORE_LOAD_FWD_EN:
    datatype: int
    paramtype: vlogparam
  MAX_EU_N:
    datatype: int
    paramtype: vlogparam
  ONLY_DOUBLEWORD_MEM_ACCESSES:
    datatype: int
    paramtype: vlogparam
  LEN5_CSR_HPMCOUNTERS_EN:
